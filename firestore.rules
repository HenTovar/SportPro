rules_version = '2';

/**
 * Reglas de seguridad de Firestore para SportPro.
 *
 * Estructura de base de datos:
 * - users/{uid}: Perfil de usuario con rol
 * - teams/{teamId}: Información del equipo
 * - teams/{teamId}/players/{playerId}: Jugadores del equipo
 * - teams/{teamId}/trainings/{trainingId}: Entrenamientos
 * - teams/{teamId}/attendance/{attendanceId}: Registros de asistencia
 * - matches/{matchId}: Información del partido
 * - matches/{matchId}/events/{eventId}: Eventos del partido
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Función para validar el rol del usuario
    function getRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin(uid) {
      return getRole(uid) == 'ADMIN';
    }

    function isTrainer(uid) {
      return getRole(uid) == 'ENTRENADOR';
    }

    function isPlayer(uid) {
      return getRole(uid) == 'JUGADOR';
    }

    function isParent(uid) {
      return getRole(uid) == 'PADRE';
    }

    function isTeamOwner(teamId, uid) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid;
    }

    // Colección de usuarios
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin(request.auth.uid);
      allow create: if request.auth.uid == uid;
      allow update, delete: if request.auth.uid == uid || isAdmin(request.auth.uid);
    }

    // Colección de equipos
    match /teams/{teamId} {
      allow read: if resource.data.isActive == true;
      allow create: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
      allow update: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
      allow delete: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);

      // Subcoleción de jugadores
      match /players/{playerId} {
        allow read: if resource.data.isActive == true &&
                       (isAdmin(request.auth.uid) ||
                        isTeamOwner(teamId, request.auth.uid) ||
                        isTrainer(request.auth.uid) ||
                        (isPlayer(request.auth.uid) && resource.data.parentUid == request.auth.uid) ||
                        (isParent(request.auth.uid) && resource.data.parentUid == request.auth.uid));

        allow create: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
        allow update: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
        allow delete: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
      }

      // Subcoleción de entrenamientos
      match /trainings/{trainingId} {
        allow read: if resource.data.isActive == true;
        allow create: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
        allow update: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
        allow delete: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
      }

      // Subcoleción de asistencia
      match /attendance/{attendanceId} {
        allow read: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid) || isTrainer(request.auth.uid);
        allow create: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid) || isTrainer(request.auth.uid);
        allow update: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid) || isTrainer(request.auth.uid);
        allow delete: if isAdmin(request.auth.uid) || isTeamOwner(teamId, request.auth.uid);
      }
    }

    // Colección de partidos y eventos
    match /matches/{matchId} {
      allow read: if resource.data.isActive == true;
      allow create: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
      allow update: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid) ||
                       (resource.data.operatorId == request.auth.uid && request.auth != null);
      allow delete: if isAdmin(request.auth.uid);

      // Subcoleción de eventos
      match /events/{eventId} {
        allow read: if get(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true;
        allow create: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid) ||
                         (get(/databases/$(database)/documents/matches/$(matchId)).data.operatorId == request.auth.uid &&
                          request.auth != null);
        allow update: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
        allow delete: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
      }

      // Subcoleción de resúmenes de IA
      match /aiSummaries/{summaryId} {
        allow read: if get(/databases/$(database)/documents/matches/$(matchId)).data.isActive == true;
        allow create: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
        allow update: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
        allow delete: if isAdmin(request.auth.uid) || isTrainer(request.auth.uid);
      }
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
